# Kopier til .env og fyll inn. .env er gitignored — hold den slik.
GARMIN_EMAIL=deg@example.com
GARMIN_PASSWORD=

# Valgfritt: TOTP-secret (base32) fra Garmin MFA-oppsettet.
# Med denne satt kan ingest re-autentisere uten interaktiv MFA-prompt.
# Krever extra: uv sync --extra totp
GARMIN_TOTP_SECRET=

# Hvor garmin.db, tokens/ og logs/ lagres. Standard: ~/.garmin-pt
# GARMIN_PT_DATA_DIR=/Users/robin/.garmin-pt
