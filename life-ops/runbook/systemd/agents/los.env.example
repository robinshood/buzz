# /etc/lifeops/los.env  (root:root, chmod 600)
# Orchestrator — opus tier, hears everything in its two channels.
BUZZ_RELAY_URL=https://buzz.example.com
BUZZ_PRIVATE_KEY=CHANGE_ME_nsec_or_hex_for_los
# From `buzz-admin mint-token` (if your build issues one):
#BUZZ_API_TOKEN=CHANGE_ME

BUZZ_ACP_AGENT_COMMAND=claude-agent-acp
BUZZ_ACP_SYSTEM_PROMPT_FILE=/srv/lifeops/prompts/los.md
BUZZ_ACP_SUBSCRIBE=agent-hq,automasjon-backlog
BUZZ_ACP_MODEL=claude-opus-5
# Closed relay: the owner-only default silently drops workflow posts and
# agent-to-agent mentions. Tighten to an allowlist later if your build supports it.
BUZZ_ACP_RESPOND_TO=anyone
BUZZ_ACP_AGENT_OWNER=CHANGE_ME_robin_hex_pubkey

# Claude auth for the harness runtime:
ANTHROPIC_API_KEY=CHANGE_ME
